# bara-edu API 서버 주소(api/). 로컬은 api 서버 기본 포트 3100.
BARA_API_URL=http://localhost:3100

# ⚠️ 로컬 전용. 운영은 SSM Parameter Store에서 읽으므로 Amplify·.env.production에 넣지 않는다.
# api/.env의 BARA_SERVICE_KEY와 같은 값(32자 이상).
BARA_API_SERVICE_KEY=change-me-to-the-same-value-as-api-BARA_SERVICE_KEY
# 관리자 개인정보 열람 토큰 서명 키. 32바이트 이상이어야 한다(짧으면 열람이 실패한다).
BARA_PII_REVEAL_SECRET=change-me-to-a-random-string-of-32-bytes-or-more


# Coming Soon 토글: false = Coming Soon 표시, true = 메인 사이트 표시
NEXT_PUBLIC_IS_OPEN=false

# 사이트명
NEXT_PUBLIC_SITE_NAME=바라 평생교육원
