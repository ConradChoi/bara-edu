# Supabase 프로젝트 설정 — Supabase 대시보드 > Project Settings > API 에서 값 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ service_role 키 — RLS를 완전히 우회하는 마스터 키. NEXT_PUBLIC_ 접두사 절대 금지,
# 절대 git에 커밋하지 말 것. 회원탈퇴(withdraw) 기능(app/actions/account.ts)에만 사용된다.
# Amplify 배포 시: 브랜치 환경변수(서버 전용)로만 등록하고, 값은 이 저장소 어디에도 남기지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 사전 신청 수집 Apps Script URL (Coming Soon 페이지 전용 — LMS 본 기능과 무관)
NEXT_PUBLIC_APPS_SCRIPT_URL=

# Coming Soon 토글: false = Coming Soon 표시, true = 메인 사이트 표시
NEXT_PUBLIC_IS_OPEN=false

# 오픈 예정일 (표시용)
NEXT_PUBLIC_OPEN_DATE=

# 사이트명
NEXT_PUBLIC_SITE_NAME=바라 평생교육원
